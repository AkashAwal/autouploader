{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "autouploader-trigger",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "observability": {
    "enabled": true
  },
  // Punctual triggers (UTC). IST = UTC + 5:30 (no daylight saving).
  //   30 5  -> 05:30 UTC = 11:00 IST  (morning slot)
  //   30 11 -> 11:30 UTC = 17:00 IST  (evening slot)
  "triggers": {
    "crons": ["30 5 * * *", "30 11 * * *"]
  },
  "vars": {
    "GH_REPO": "AkashAwal/autouploader",
    "GH_WORKFLOW": "upload.yml",
    "GH_REF": "main"
  }
  // Secret (set with `wrangler secret put GH_TOKEN`):
  //   GH_TOKEN -> fine-grained GitHub PAT with Actions: Read and write on this repo
}
